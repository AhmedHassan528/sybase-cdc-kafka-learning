<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="05-connector-lifecycle" name="Connector lifecycle"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Kafka Connect lifecycle of SybaseCdcSourceConnector / SybaseCdcSourceTask" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Who calls what, in which order. Methods in blue are ours; Connect framework actions are orange." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="w1" value="Worker starts&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;scans plugin.path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="180" height="60" as="geometry"/></mxCell>
