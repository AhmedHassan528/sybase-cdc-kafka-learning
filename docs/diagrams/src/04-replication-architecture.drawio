<mxCell id="title" value="Replication architecture: classic SAP Replication Server vs. this project" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="RepAgent only knows how to talk to &quot;a Replication Server&quot;. The connector answers the same protocol, so RepAgent needs no change; SAP Replication Server is not installed." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="ga" value="A. Classic SAP topology (not used here)" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1060" height="150" as="geometry"/></mxCell>
<mxCell id="gb" value="B. This project" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1060" height="150" as="geometry"/></mxCell>
<mxCell id="a1" value="Primary ASE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RepAgent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="ga"><mxGeometry x="20" y="50" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="a2" value="SAP Replication Server&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;stable queues, repdefs, subscriptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="ga"><mxGeometry x="280" y="50" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="a3" value="Replicate ASE / other DB&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DSI applies SQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="ga"><mxGeometry x="640" y="50" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="b1" value="Primary ASE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RepAgent (unchanged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="gb"><mxGeometry x="20" y="50" width="170" height="60" as="geometry"/></mxCell>
