<mxCell id="n" value="Same idea in a commercial product: Qlik Replicate &quot;RepAgent CDC&quot; (Preview) also points RepAgent at its own listener." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="660" height="46" as="geometry"/></mxCell>
