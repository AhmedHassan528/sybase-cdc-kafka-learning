<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="04-replication-architecture" name="Replication architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
