<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="02-cdc-data-flow" name="CDC data flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="End-to-end CDC data flow: one committed row change" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Read the numbers in order. Steps 1–4 happen inside ASE, 5–9 in the connector, 10–12 in Kafka. Nothing is published before step 7 (COMMIT)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="s1" value="1. Application commits&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;insert payment ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s2" value="2. ASE writes log records&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;begin, insert, commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s3" value="3. RepAgent scans log&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;marked tables only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s4" value="4. RepAgent sends LTL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;distribute ... over TDS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710" y="90" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s5" value="5. LtlSession receives&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one DONE per message&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710" y="210" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s6" value="6. LtlParser decodes&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LtlCommand objects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="210" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s7" value="7. TransactionBuffer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;release on COMMIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="210" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s8" value="8. Queue + poll()&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bounded = back-pressure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s9" value="9. SourceRecord&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;topic, key, value, offset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s10" value="10. Producer writes&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JsonConverter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="330" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s11" value="11. Broker acks&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;commitRecord()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="s12" value="12. Next get truncation&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;log space released&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710" y="330" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="rb" value="ROLLBACK&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rows discarded, nothing published&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="450" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
