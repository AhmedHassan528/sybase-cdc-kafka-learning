<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="08-docker-topology" name="Docker topology"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Local Docker topology (docker-compose.yml)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1150" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Containers reach each other by service name on one bridge network. &quot;host:&quot; is the port published on localhost for you (isql, curl, browser); containers never use it." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1150" height="30" as="geometry"/></mxCell>
<mxCell id="host" value="Windows host (Docker Desktop, WSL2 kernel 6.18)" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1160" height="440" as="geometry"/></mxCell>
<mxCell id="net" value="bridge network &lt;project-folder&gt;_default (172.20.0.0/16)" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#e8f4f8;strokeColor=#999999;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="host"><mxGeometry x="250" y="40" width="880" height="370" as="geometry"/></mxCell>
<mxCell id="you" value="You: isql, curl, browser&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;via published localhost ports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="host"><mxGeometry x="20" y="150" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="syb" value="cdc-sybase (service sybase)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;datagrip/sybase · ASE on 5000&lt;br&gt;host: localhost:5000&lt;br&gt;bind ./sybase → /scripts (ro)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="net"><mxGeometry x="30" y="50" width="250" height="90" as="geometry"/></mxCell>
<mxCell id="con" value="cdc-connect (service connect)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;apache/kafka:3.8.0 · REST 8083, LTL 11752&lt;br&gt;host: localhost:8083, :11752&lt;br&gt;bind ./plugins → /opt/connectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="net"><mxGeometry x="400" y="50" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="kaf" value="cdc-kafka (service kafka)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;apache/kafka:3.8.0, KRaft&lt;br&gt;internal kafka:9092 · host: localhost:29092&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="net"><mxGeometry x="400" y="210" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="ui" value="cdc-kafka-ui&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;provectuslabs/kafka-ui&lt;br&gt;host: localhost:8080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="net"><mxGeometry x="740" y="210" width="120" height="80" as="geometry"/></mxCell>
<mxCell id="n1" value="No named volumes: the ASE database lives in the container layer. &quot;docker compose down&quot; deletes it; &quot;stop&quot; / &quot;restart&quot; keep it." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="net"><mxGeometry x="30" y="300" width="650" height="50" as="geometry"/></mxCell>
<mxCell id="e0" value="LTL :11752" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="net" source="syb" target="con"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="kafka:9092" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="net" source="con" target="kaf"><mxGeometry relative="1" as="geometry"/></mxCell>
