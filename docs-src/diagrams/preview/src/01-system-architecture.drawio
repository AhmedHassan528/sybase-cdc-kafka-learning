<mxCell id="title" value="Sybase ASE → Kafka CDC: system architecture (verified local build)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1180" height="36" as="geometry"/></mxCell>
