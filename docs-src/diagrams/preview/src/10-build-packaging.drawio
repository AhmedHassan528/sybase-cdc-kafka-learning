<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="10-build-packaging" name="Build and packaging"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="From source code to a Kafka Connect plugin" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1150" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="build.sh runs Maven inside maven:3.9-eclipse-temurin-17, so no JDK is needed on the host. connect-api and slf4j are &quot;provided&quot;: the worker already has them." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1150" height="30" as="geometry"/></mxCell>
<mxCell id="s" value="src/main/java&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;19 classes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="c" value="javac --release 17&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;maven-compiler&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="t" value="surefire tests&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;11 tests, real LTL fixtures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="r" value="src/main/resources&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;META-INF/services/...SourceConnector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="j" value="jar + shade&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sybase-cdc-connector-0.1.0.jar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="670" y="90" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="p" value="plugins/sybase-cdc/&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bind-mounted at /opt/connectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="90" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="w" value="Worker scans plugin.path&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;isolated classloader&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="200" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="l" value="GET /connector-plugins&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;lists SybaseCdcSourceConnector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="310" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="n" value="provided (not in JAR): connect-api 3.8.0, slf4j-api 1.7.36. test: junit 5.10.2. No runtime dependencies, so the shaded JAR equals the plain JAR (same SHA-256)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="600" height="60" as="geometry"/></mxCell>
