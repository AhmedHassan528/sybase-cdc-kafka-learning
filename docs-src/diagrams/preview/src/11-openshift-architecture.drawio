<mxCell id="ifc" value="interfaces: CDC_RS&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LB VIP / node IP : port&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="dc"><mxGeometry x="40" y="150" width="190" height="60" as="geometry"/></mxCell>
