<mxCell id="title" value="Target deployment on OpenShift (proposed, not yet deployed)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="ASE runs outside the cluster, so RepAgent needs a TCP path to the single Connect pod running the task. OpenShift Routes carry HTTP/TLS-SNI only, so use a LoadBalancer or NodePort Service." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="dc" value="Bank data centre" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="260" height="420" as="geometry"/></mxCell>
<mxCell id="oc" value="OpenShift cluster" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="860" height="420" as="geometry"/></mxCell>
