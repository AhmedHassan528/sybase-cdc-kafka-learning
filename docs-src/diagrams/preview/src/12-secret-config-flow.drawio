<mxCell id="title" value="Configuration and secret management flow" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1150" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="The RepAgent password exists in two places that must stay equal: ASE (set by the DBA) and the connector (from a Secret). The CRs live in Git without secrets; nothing secret goes into Git or the image." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1150" height="30" as="geometry"/></mxCell>
