<mxCell id="lg_s1" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lg"><mxGeometry x="10" y="54" width="40" height="18" as="geometry"/></mxCell>
