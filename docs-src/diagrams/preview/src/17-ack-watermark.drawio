<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="17-ack-watermark" name="Acknowledgement watermark"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Why ASE never frees log that is not in Kafka" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Transactions finish in commit order T1, T2, T3. Kafka may acknowledge T2 before T1. The watermark only moves past a transaction when it and everything before it is fully acknowledged." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="t1" value="T1: 2 records&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1 acked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="t2" value="T2: 1 record&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;acked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="t3" value="T3: 0 records&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(other tables only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="w" value="watermark = before T1&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;get truncation returns it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="n" value="When T1's 2nd record is acked, the watermark jumps to T3 in one step (AckTrackerTest proves this)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="210" width="370" height="60" as="geometry"/></mxCell>
<mxCell id="o" value="Connect offsets: only the LAST record of a transaction carries its commit OQID (fix verified by test 6b)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;dashed=1;strokeColor=#9a6100;fontColor=#9a6100;" edge="1" parent="1" source="t1" target="w"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="lg" value="Legend" style="swimlane;startSize=22;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="620" y="210" width="280" height="108" as="geometry"/></mxCell>
