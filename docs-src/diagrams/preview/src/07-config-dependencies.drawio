<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="07-config-dependencies" name="Configuration dependencies"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Configuration values that must agree with each other" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1150" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Each line joins two settings that must match. A mismatch is the most common setup failure; the right column names the symptom." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1150" height="30" as="geometry"/></mxCell>
<mxCell id="gs" value="ASE side (DBA)" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="320" height="400" as="geometry"/></mxCell>
<mxCell id="gc" value="Connector config (JSON / KafkaConnector CR)" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="330" height="400" as="geometry"/></mxCell>
<mxCell id="a1" value="interfaces: CDC_RS&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;host connect, port 11752&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="gs"><mxGeometry x="20" y="40" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="a2" value="sp_config_rep_agent ... 'enable'&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;'CDC_RS', 'rs_user', '&amp;lt;password&amp;gt;'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="gs"><mxGeometry x="20" y="120" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="a3" value="net password encryption = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="gs"><mxGeometry x="20" y="200" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="a4" value="@@servername / database&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MYSYBASE / phoenix_test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="gs"><mxGeometry x="20" y="280" width="280" height="60" as="geometry"/></mxCell>
