<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="03-repagent-transaction-flow" name="Transaction and RepAgent flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="How one ASE transaction becomes LTL commands" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Left: what ASE writes to the transaction log. Middle: the LTL 760 command RepAgent sends for each record. Right: what the connector does with it." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="g1" value="ASE transaction log (syslogs)" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="300" height="380" as="geometry"/></mxCell>
<mxCell id="g2" value="LTL 760 sent by RepAgent" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="400" height="380" as="geometry"/></mxCell>
<mxCell id="g3" value="Connector action" style="swimlane;startSize=26;html=1;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fcfcfc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="300" height="380" as="geometry"/></mxCell>
<mxCell id="l1" value="BEGINXACT&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;xid 0x...1c6d001a&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="g1"><mxGeometry x="20" y="40" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="l2" value="INSERT row&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;payment (marked with sp_setreptable)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="g1"><mxGeometry x="20" y="120" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="l3" value="UPDATE row&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;before + after images&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="g1"><mxGeometry x="20" y="200" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="l4" value="ENDXACT (commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="g1"><mxGeometry x="20" y="280" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="c1" value="distribute 1 time,4 oqid,6 xid&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;begin transaction ~&quot;%_ins npw ~&quot;#sa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g2"><mxGeometry x="20" y="40" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="c2" value="distribute 4 oqid,6 xid applied&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;~&quot;(payment.~!*rs_insert yielding after ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g2"><mxGeometry x="20" y="120" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="c3" value="distribute ... rs_update yielding&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;before (all cols) after (changed cols)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g2"><mxGeometry x="20" y="200" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="c4" value="distribute 1 time,4 oqid,6 xid&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;commit transaction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g2"><mxGeometry x="20" y="280" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="a1" value="open buffer for xid&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;remember user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="g3"><mxGeometry x="20" y="40" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="a2" value="append INSERT (after image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="g3"><mxGeometry x="20" y="120" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="a3" value="append UPDATE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;after = before + changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="g3"><mxGeometry x="20" y="200" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="a4" value="publish all rows&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;commit OQID = new position&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="g3"><mxGeometry x="20" y="280" width="260" height="50" as="geometry"/></mxCell>
