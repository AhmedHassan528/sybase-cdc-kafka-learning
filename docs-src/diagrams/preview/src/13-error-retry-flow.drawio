<mxfile host="drawio-gen" agent="sybase-cdc docs"><diagram id="13-error-retry-flow" name="Error handling and retry"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="0" adaptiveColors="auto"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Error handling and recovery paths (all verified in tests 4–7 unless marked)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Every failure ends in the same safe place: RepAgent re-sends from the last truncation point the connector gave it, and duplicates are dropped by commit OQID or by consumers." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="f1" value="Unparsable LTL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(not seen in tests)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="f2" value="Connect worker killed&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;test 4b, 6b&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="f3" value="Kafka unreachable&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;test P5 (44 s pause)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="f4" value="ASE crash&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;test 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="f5" value="Connector stopped long&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;test 7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="a1" value="drop TDS connection&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;never acknowledge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="a2" value="socket closes&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;offsets: last full txn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="220" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="a3" value="no producer ack&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;truncation frozen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="220" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="a4" value="ASE recovery&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RepAgent auto start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="a5" value="log grows&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;threshold alert at 75% free&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="k3" value="&amp;gt;10 s outage: worker rebalances&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;task restarts (seen in P5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="r" value="RepAgent reconnects after retry timeout (10 s here) and asks: get truncation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1070" height="46" as="geometry"/></mxCell>
