    { "id": "connectors", "run": "curl -s localhost:8083/connectors" },
    { "id": "config", "run": "curl -s localhost:8083/connectors/sybase-cdc-phoenix/config" },
    { "id": "status", "run": "curl -s localhost:8083/connectors/sybase-cdc-phoenix/status", "mask": ["worker=\"worker_id\":\"[^\"]+\""] }
  ]
}
